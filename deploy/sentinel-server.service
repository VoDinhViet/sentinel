[Unit]
Description=Sentinel central server (web UI and agent API)
Documentation=https://github.com/OWNER/sentinel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/sentinel server run --server-config /etc/sentinel/server.yaml
Restart=on-failure
RestartSec=10s

StateDirectory=sentinel
ProtectSystem=full
PrivateTmp=true
NoNewPrivileges=true
# Binding a port below 1024 (e.g. 443) without running as root:
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
